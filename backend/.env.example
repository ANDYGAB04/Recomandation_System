# Copiază în .env și modifică după nevoie. Toate variabilele au valori implicite.

# Calea fișierului SQLite (relativă la directorul backend/)
HOBBYSHOP_DATABASE_PATH=data/hobbyshop.db

# Cheia folosită la semnarea token-urilor de autentificare (schimb-o!)
HOBBYSHOP_SECRET_KEY=schimba-cheia-asta

# Adresele de unde frontendul poate apela API-ul (separate prin virgulă)
HOBBYSHOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
